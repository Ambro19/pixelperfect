# =============================================================================
# backend/.gitignore - PixelPerfect API
# Release D (Nov 2026): cleaned up. The old file ended with a pasted shell
# snippet ("EOF", "git add .", ...) and did not cover SQLite WAL files,
# zips or executables, which is how they ended up in the public repo.
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# Virtual environments (the project's venv lives one folder up)
venv/
.venv/
env/
ENV/

# Secrets: only .env.example (placeholders) is committed
.env
.env.*
!.env.example

# Local databases, including SQLite's write-ahead files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Release zips, downloaded tools and binaries
*.zip
*.exe
stripe-cli/
tools/

# Runtime output
screenshots/
uploads/
*.log
.batch_jobs_snapshot.json

# Testing
.coverage
htmlcov/
.pytest_cache/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Internal notes
INTERNAL.md
